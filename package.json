{
  "name": "gterminal",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "pwsh -NoProfile -File tests/typing.ps1 && pwsh -NoProfile -File tests/lifecycle.ps1 && node tests/contrast.mjs && node tests/keys.mjs && node tests/styles.mjs && cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:keys": "node tests/keys.mjs",
    "test:typing": "pwsh -NoProfile -File tests/typing.ps1",
    "test:lifecycle": "pwsh -NoProfile -File tests/lifecycle.ps1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
